# ═══════════════════════════════════════════════════════════════
# Kidstorte — Environment-Konfiguration
# Kopiere zu  .env  und ersetze die Werte. NIEMALS .env committen!
# ═══════════════════════════════════════════════════════════════

# ── PFLICHT ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ADMIN_PASSWORD=bitte-aendern-sonst-ist-admin-offen

# ── MODELLE (Defaults sind sinnvoll) ────────────────────────────
CHAT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1-mini
VISION_MODEL=gpt-4o-mini

# ── TRACING (optional, aber empfohlen) ──────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Kidstorte
LANGSMITH_TRACING=true

# ── BILD-FALLBACK wenn OpenAI ausfällt (optional) ───────────────
HUGGINGFACE_API_KEY=

# ── KALENDER cal.com (optional — sonst lokaler SQLite-Fallback) ─
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_USERNAME=
CAL_TIMEZONE=Europe/Berlin

# ── ÖFFNUNGSZEITEN ──────────────────────────────────────────────
BAKERY_OPEN_HOUR=8
BAKERY_CLOSE_HOUR=18
BAKERY_CLOSED_DAYS=6              # 0=Mo, 6=So

# ── E-MAIL für Bestellbestätigungen (optional) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DESIGNER_EMAIL=designer@kidstorte.de
SHOP_NAME=Kidstorte

# ── PFADE (für Docker nicht ändern!) ────────────────────────────
REFERENCE_IMAGE_DIR=Bilder
