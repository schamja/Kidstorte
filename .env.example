# ═══════════════════════════════════════════════════════════════
# Kidstorte — Environment-Konfiguration
# Kopiere zu  .env  und ersetze die Werte. NIEMALS .env committen!
# ═══════════════════════════════════════════════════════════════

# ── PFLICHT ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ADMIN_PASSWORD=bitte-aendern-sonst-ist-admin-offen

# ── MODELLE (Defaults sind sinnvoll) ────────────────────────────
CHAT_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1-mini
VISION_MODEL=gpt-4o-mini

# ── TRACING (optional) ──────────────────────────────────────────
# WICHTIG für lokale Demos: =false setzen!
# Jeder traced Node macht 2 synchrone HTTP-Calls zu api.smith.langchain.com
# (US-Server) → 2–7 s zusätzliche Latenz pro Chat-Turn aus Europa.
# Nur für Production/Debug-Sessions einschalten wenn du die Traces brauchst.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Kidstorte
LANGSMITH_TRACING=false

# ── BILD-FALLBACK wenn OpenAI ausfällt (optional) ───────────────
HUGGINGFACE_API_KEY=

# ── KALENDER cal.com (optional — sonst lokaler SQLite-Fallback) ─
CAL_API_KEY=
CAL_EVENT_TYPE_ID=
CAL_USERNAME=
CAL_TIMEZONE=Europe/Berlin

# ── ÖFFNUNGSZEITEN ──────────────────────────────────────────────
BAKERY_OPEN_HOUR=8
BAKERY_CLOSE_HOUR=18
BAKERY_CLOSED_DAYS=6              # 0=Mo, 6=So

# ── E-MAIL für Bestellbestätigungen (optional) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DESIGNER_EMAIL=designer@kidstorte.de
SHOP_NAME=Kidstorte

# ── PFADE (für Docker nicht ändern!) ────────────────────────────
REFERENCE_IMAGE_DIR=Bilder

# ── CASA PASTEL ─────────────────────────────────────────────────
# 0 = Casa Pastel nur unter /casa (Startseite bleibt Kidstorte)
# 1 = Casa Pastel ist die Startseite (/), alte Kidstorte-Seite entfällt
CASA_PASTEL_AT_ROOT=0
