{
  "uid": "kidstorte-main",
  "title": "Kidstorte — Container & Logs",
  "tags": ["kidstorte", "docker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kidstorte Up?",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"kidstorte-health\"}", "refId": "A"}],
      "options": {"colorMode": "background", "graphMode": "none"},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Running Container",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(container_last_seen{name!=\"\"})", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Host CPU %",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 70, "color": "yellow"}, {"value": 90, "color": "red"}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Host RAM",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container CPU (%)",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"kidstorte.*\"}[1m])) by (name) * 100",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container RAM (MB)",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "expr": "container_memory_usage_bytes{name=~\"kidstorte.*\"} / 1024 / 1024",
        "legendFormat": "{{name}}",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Network In/Out (kB/s)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(container_network_receive_bytes_total{name=~\"kidstorte.*\"}[1m]) / 1024", "legendFormat": "RX {{name}}", "refId": "A"},
        {"expr": "rate(container_network_transmit_bytes_total{name=~\"kidstorte.*\"}[1m]) / 1024", "legendFormat": "TX {{name}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Kbits"}}
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Kidstorte-Logs (Live)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{
        "expr": "{container=\"kidstorte\"}",
        "refId": "A"
      }],
      "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"}
    }
  ]
}
